/* Tampilan seluruh halaman */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    background-color: #fff0f5;
    color: #5c3444;
}

/* Bagian judul */
header {
    background-color: #e75480;
    color: white;
    text-align: center;
    padding: 30px;
}

/* Menu navigasi */
nav {
    background-color: #ffe4ec;
    text-align: center;
    padding: 15px;
}

nav a {
    color: #a8325b;
    text-decoration: none;
    margin: 15px;
    font-weight: bold;
}

/* Bagian utama */
.hero {
    text-align: center;
    padding: 60px 20px;
    background-color: #fff8fa;
}

.tombol {
    display: inline-block;
    background-color: #e75480;
    color: white;
    padding: 12px 20px;
    text-decoration: none;
    border-radius: 20px;
}

/* Artikel */
.tentang {
    text-align: center;
    padding: 30px;
    line-height: 1.8;
}

/* Galeri */
.galeri {
    text-align: center;
    padding: 30px 15px;
}

.container {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
}

.kartu {
    background-color: white;
    width: 280px;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 4px 10px #e5b7c6;
    padding-bottom: 15px;
}

.kartu img {
    width: 100%;
    height: 220px;
    object-fit: cover;
}

.kartu p {
    padding: 0 10px;
}

/* Bagian bawah */
footer {
    background-color: #e75480;
    color: white;
    text-align: center;
    padding: 15px;
}

/* Tampilan HP */
@media (max-width: 600px) {
    nav a {
        margin: 6px;
    }

    .kartu {
        width: 100%;
        max-width: 320px;
    }
}
